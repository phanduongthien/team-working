# Cấu hình Supabase cho dữ liệu team. Copy file này thành:
#   .env              → mặc định cho mọi lệnh (hiện dùng project DEV/TEST)
#   .env.production   → project PROD; `npm run build:win` tự dùng file này (đè lên .env)
# (`npm run build:win:dev` build bản cài trỏ về project dev để thử.)
#
# Anon/publishable key được phép nằm trong app vì mọi bảng có RLS.
# KHÔNG BAO GIỜ đặt service-role / sb_secret_ key ở đây hay trong app — app sẽ từ chối.
#
# Trên Supabase → Authentication → URL Configuration → Redirect URLs, thêm:
#   http://127.0.0.1:47823/auth/callback
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# development (trong .env) hoặc production (trong .env.production) — app hiện nhãn DEV khi không phải production.
VITE_APP_ENV=development

# GIF/sticker GIPHY cho bản DEV (tuỳ chọn). Không có tiền tố VITE_ nên không bao giờ nằm trong bộ cài.
# Bản cài: mỗi người dán key của mình trong Cài đặt → Chat biểu cảm (mã hoá trên máy).
# Lấy key miễn phí: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=
